# ============================================================================
# Webhook Delivery Worker - Production Environment Configuration
# ============================================================================
# Location: /opt/livekit1/ops/config/webhook-delivery.env
# Permissions: 640 (root:www-data)
# Used by: /opt/livekit1/ops/systemd/webhook-delivery.service
# ============================================================================

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql://postgres:nXrRje4emjejjeKI009p@localhost:5432/epic_voice_db

# ============================================================================
# Worker Configuration
# ============================================================================
# Poll interval (seconds) - how often to check queue when empty
WORKER_POLL_INTERVAL=5

# Batch size - how many webhooks to process per poll
WORKER_BATCH_SIZE=10

# Worker timeout (seconds) - maximum time for HTTP request
WORKER_TIMEOUT=30

# ============================================================================
# Retry Configuration
# ============================================================================
# Base delay for exponential backoff (seconds)
RETRY_BASE_DELAY=30

# Maximum delay between retries (seconds)
RETRY_MAX_DELAY=3600

# Maximum delivery attempts before dead letter
RETRY_MAX_ATTEMPTS=5

# ============================================================================
# HTTP Configuration
# ============================================================================
# HTTP request timeout (seconds)
HTTP_TIMEOUT=30

# HTTP connection pool size
HTTP_POOL_SIZE=10

# HTTP max retries for network errors
HTTP_MAX_RETRIES=3

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (in addition to systemd journal)
LOG_FILE=/opt/livekit1/logs/webhook-delivery.log

# Log format (with worker_id placeholder)
LOG_FORMAT=%(asctime)s [%(levelname)s] [Worker-%(worker_id)s] %(message)s

# ============================================================================
# Metrics Configuration (Optional)
# ============================================================================
# Enable Prometheus metrics endpoint
METRICS_ENABLED=true

# Metrics HTTP server port (base port, +1 for each instance)
METRICS_PORT=9090

# Metrics path
METRICS_PATH=/metrics

# ============================================================================
# Security Configuration
# ============================================================================
# Encryption key for webhook secrets (base64 encoded)
# Generate with: python3 -c "import base64; import os; print(base64.b64encode(os.urandom(32)).decode())"
# IMPORTANT: Generate a new key for production deployment
WEBHOOK_SECRET_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_KEY_IN_PRODUCTION

# ============================================================================
# Feature Flags
# ============================================================================
# Enable webhook delivery audit log
AUDIT_LOG_ENABLED=true

# Enable dead letter queue notifications
DEAD_LETTER_NOTIFICATIONS=true

# ============================================================================
# Performance Tuning
# ============================================================================
# Database connection pool size
DB_POOL_SIZE=10

# Database connection pool timeout (seconds)
DB_POOL_TIMEOUT=30

# Maximum concurrent webhook deliveries per worker
MAX_CONCURRENT_DELIVERIES=10

# ============================================================================
# Production Settings
# ============================================================================
# Python path (if needed)
PYTHONPATH=/opt/livekit1

# Python unbuffered output for better logging
PYTHONUNBUFFERED=1
