generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounts {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  users             users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model agent_configs {
  id                       String           @id
  userId                   String
  name                     String
  description              String?
  instructions             String
  llmModel                 String?
  voice                    String?
  temperature              Float?
  language                 String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime
  isActive                 Boolean          @default(true)
  agentMode                String?          @default("standard")
  llmProvider              String?          @default("openai")
  sttProvider              String?          @default("deepgram")
  sttModel                 String?          @default("nova-2")
  sttLanguage              String?          @default("en")
  ttsProvider              String?          @default("openai")
  ttsModel                 String?
  ttsVoiceId               String?
  realtimeVoice            String?          @default("alloy")
  vadEnabled               Boolean          @default(true)
  vadProvider              String?          @default("silero")
  turnDetectionModel       String?          @default("multilingual")
  noiseCancellationEnabled Boolean          @default(true)
  noiseCancellationType    String?          @default("BVC")
  preemptiveGeneration     Boolean          @default(false)
  resumeFalseInterruption  Boolean          @default(false)
  falseInterruptionTimeout Float?           @default(1.0)
  minInterruptionDuration  Float?           @default(0.2)
  greetingEnabled          Boolean          @default(true)
  greetingMessage          String?
  filePath                 String?
  status                   String?          @default("created")
  agentId                  String?
  users                    users            @relation(fields: [userId], references: [id], onDelete: Cascade)
  call_logs                call_logs[]
  phone_mappings           phone_mappings[]
}

model api_keys {
  id             String        @id
  organizationId String
  name           String
  key            String        @unique
  lastUsed       DateTime?
  createdAt      DateTime      @default(now())
  expiresAt      DateTime?
  organizations  organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model call_logs {
  id              String         @id
  userId          String
  agentConfigId   String?
  phoneNumber     String?
  roomName        String?
  durationSeconds Int?
  startedAt       DateTime       @default(now())
  endedAt         DateTime?
  cost            Float?
  agent_configs   agent_configs? @relation(fields: [agentConfigId], references: [id])
  users           users          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model memberships {
  id             String        @id
  userId         String
  organizationId String
  role           String        @default("member")
  createdAt      DateTime      @default(now())
  organizations  organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          users         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model organizations {
  id            String          @id
  name          String
  ownerId       String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  api_keys      api_keys[]
  memberships   memberships[]
  users         users           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  room_sessions room_sessions[]
  subscriptions subscriptions?
  usage         usage[]
}

model phone_mappings {
  id            String        @id
  userId        String
  agentConfigId String
  phoneNumber   String        @unique
  sipTrunkId    String?
  sipConfigId   String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  agent_configs agent_configs @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  users         users         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model phone_number_history {
  id             String   @id
  phoneNumber    String
  userId         String?
  agentId        String?
  action         String
  previousStatus String?
  newStatus      String?
  performedBy    String?
  notes          String?
  createdAt      DateTime @default(now())

  @@index([phoneNumber])
}

model phone_number_pool {
  id                String    @id
  phoneNumber       String    @unique
  countryCode       String?
  country           String?
  provider          String?
  providerId        String?
  status            String?
  assignedToUserId  String?
  assignedToAgentId String?
  assignedAt        DateTime?
  canReceiveCalls   Boolean   @default(true)
  canSendCalls      Boolean   @default(true)
  canReceiveSms     Boolean   @default(false)
  canSendSms        Boolean   @default(false)
  purchaseDate      DateTime?
  monthlyCost       Int?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime

  @@index([assignedToUserId])
  @@index([status])
}

model room_sessions {
  id               String        @id
  organizationId   String
  roomName         String
  startedAt        DateTime      @default(now())
  endedAt          DateTime?
  minutes          Int           @default(0)
  participantCount Int           @default(0)
  organizations    organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model sessions {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model sip_configs {
  id              String   @id
  userId          String
  name            String
  sipUrl          String
  sipUsername     String?
  sipPassword     String?
  sipTransport    String   @default("tcp")
  trunkId         String?
  isDefault       Boolean  @default(false)
  inboundEnabled  Boolean  @default(true)
  outboundEnabled Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  users           users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model subscriptions {
  id               String        @id
  organizationId   String        @unique
  status           String
  provider         String        @default("stripe")
  providerId       String?
  priceId          String?
  plan             String?
  currentPeriodEnd DateTime?
  trialEndsAt      DateTime?
  cancelAt         DateTime?
  canceledAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  organizations    organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model usage {
  id             String        @id
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  minutesUsed    Int           @default(0)
  tokensUsed     Int           @default(0)
  roomsCreated   Int           @default(0)
  createdAt      DateTime      @default(now())
  organizations  organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model users {
  id                  String           @id
  email               String           @unique
  emailVerified       DateTime?
  name                String?
  image               String?
  password            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime
  isActive            Boolean          @default(true)
  onboardingCompleted Boolean          @default(false)
  accounts            accounts[]
  agent_configs       agent_configs[]
  call_logs           call_logs[]
  memberships         memberships[]
  organizations       organizations[]
  phone_mappings      phone_mappings[]
  sessions            sessions[]
  sip_configs         sip_configs[]
}

model verification_tokens {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
