# Funnel Worker Systemd Service Unit (Templated)
# COPIED FROM webhook_worker systemd pattern
#
# This is a templated unit file that allows running multiple worker instances.
# The @ symbol makes this a template, and %i is replaced with the instance number.
#
# Usage:
#   sudo systemctl start funnel-worker@1    # Start instance 1
#   sudo systemctl start funnel-worker@2    # Start instance 2
#   sudo systemctl start funnel-worker@3    # Start instance 3
#
# Install:
#   sudo cp funnel-worker@.service /etc/systemd/system/
#   sudo systemctl daemon-reload

[Unit]
Description=Funnel Worker Instance %i
Documentation=file:///opt/livekit1/backend/funnel_engine/README.md
After=postgresql.service network.target
Wants=postgresql.service
PartOf=funnel-worker.target

[Service]
# Service type
Type=simple

# User and group
User=agent3
Group=claudegroup

# Working directory
WorkingDirectory=/opt/livekit1/backend/funnel_engine

# Environment file
EnvironmentFile=/opt/livekit1/backend/funnel_engine/funnel-worker.env

# Override worker name with instance number
Environment="WORKER_NAME=funnel-worker-%i"

# Command to execute
ExecStart=/usr/bin/python3 funnel_worker.py

# Restart policy (COPIED FROM webhook_worker)
Restart=always
RestartSec=10

# Resource limits (COPIED FROM webhook_worker)
MemoryLimit=512M
CPUQuota=50%

# Standard output and error
StandardOutput=journal
StandardError=journal

# Logging
SyslogIdentifier=funnel-worker-%i

# Security hardening (COPIED FROM webhook_worker)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/livekit1/backend/funnel_engine

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=funnel-worker.target
WantedBy=multi-user.target
