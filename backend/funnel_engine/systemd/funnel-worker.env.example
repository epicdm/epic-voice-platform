# Funnel Worker Environment Configuration
# COPIED FROM webhook_worker systemd pattern

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/livekit_saas

# ============================================================================
# WORKER CONFIGURATION
# ============================================================================

# Poll interval in seconds (how often to check queue)
# Default: 5 seconds
# Lower = more responsive, higher CPU
# Higher = less responsive, lower CPU
WORKER_POLL_INTERVAL=5

# Batch size (how many stages to process per poll)
# Default: 10
# Higher = more throughput, more memory
WORKER_BATCH_SIZE=10

# Worker name (for logging)
# This will be set automatically by systemd template: funnel-worker-{instance}
WORKER_NAME=funnel-worker-1

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================================
# RETRY CONFIGURATION
# ============================================================================

# Maximum retry attempts per stage
# Default: 3
# Retry schedule: 30s, 60s, 120s (3 attempts)
RETRY_MAX_ATTEMPTS=3

# ============================================================================
# HTTP CONFIGURATION (for webhook nodes)
# ============================================================================

# HTTP request timeout in seconds
HTTP_TIMEOUT=30

# ============================================================================
# NOTES
# ============================================================================

# After editing this file:
# 1. Copy to: /opt/livekit1/backend/funnel_engine/funnel-worker.env
# 2. Set proper permissions: chmod 600 funnel-worker.env
# 3. Reload systemd: sudo systemctl daemon-reload
# 4. Restart workers: sudo systemctl restart funnel-worker.target
