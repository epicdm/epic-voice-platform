# Funnel Worker Systemd Target
# COPIED FROM webhook_worker systemd pattern
#
# This target unit manages multiple funnel worker instances as a group.
# Starting/stopping this target affects all worker instances.
#
# Usage:
#   sudo systemctl start funnel-worker.target    # Start all workers
#   sudo systemctl stop funnel-worker.target     # Stop all workers
#   sudo systemctl status funnel-worker.target   # Check status
#
# Install:
#   sudo cp funnel-worker.target /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable funnel-worker.target

[Unit]
Description=Funnel Worker Cluster
Documentation=file:///opt/livekit1/backend/funnel_engine/README.md
After=postgresql.service network.target

# Default worker instances (3 workers for horizontal scaling)
Wants=funnel-worker@1.service
Wants=funnel-worker@2.service
Wants=funnel-worker@3.service

[Install]
WantedBy=multi-user.target
