[Unit]
Description=LiveKit Agent Management Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/livekit1
ExecStart=/usr/bin/env uv run python admin_dashboard.py
Restart=always
RestartSec=10
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

[Install]
WantedBy=multi-user.target
